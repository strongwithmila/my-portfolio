---
import { Picture } from 'astro:assets';
import { method } from '../content/site';

const accent: Record<string, string> = {
  train: 'var(--plum)',
  fuel: 'var(--forest)',
  understand: 'var(--navy)',
};
---

<section class="section section--alt" id="method" aria-labelledby="method-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">The method</p>
      <h2 id="method-title">{method.heading}</h2>
      <p class="lead">{method.intro}</p>
    </div>

    <ol class="pillars">
      {method.pillars.map((p, i) => (
        <li class="pillar" style={`--accent: ${accent[p.key]}`}>
          <div class="pillar__media">
            {p.image ? (
              <Picture
                src={p.image}
                alt={p.imageAlt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[400, 600, 900]}
                sizes="(min-width: 52rem) 30vw, 90vw"
              />
            ) : (
              <div class="pillar__placeholder" role="img" aria-label={`Photo coming soon: ${p.name}`}>
                <span>Photo coming soon · {p.name}</span>
              </div>
            )}
          </div>
          <p class="pillar__label" aria-hidden="true">0{i + 1} / {p.name}</p>
          <h3>{p.name}</h3>
          <p class="pillar__summary">{p.summary}</p>
          <p class="pillar__text">{p.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Phones: features stacked, image first */
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 8vw, 4rem);
  }
  .pillar__media {
    aspect-ratio: 3 / 4;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--cream);
    /* Pillar colour along the top edge */
    border-top: 3px solid var(--accent);
  }
  .pillar__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pillar__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(58 42 36 / 0.6);
  }
  .pillar__label {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pillar h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 1.6rem + 1vw, 2.4rem);
    font-weight: 400;
    color: var(--accent);
  }
  .pillar__summary {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--brown);
  }
  .pillar__text {
    max-width: 26rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(58 42 36 / 0.85);
  }

  /* Desktop: three editorial columns, images aligned across the top */
  @media (min-width: 52rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }
</style>
