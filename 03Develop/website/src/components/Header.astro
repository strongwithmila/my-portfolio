---
import Wordmark from './Wordmark.astro';
import { cta } from '../content/site';

const links = [
  { href: '#method', label: 'Method' },
  { href: '#package', label: 'Package' },
  { href: '#about', label: 'About' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__brand" aria-label="Strong with Mila, back to top">
      <Wordmark />
    </a>

    <nav aria-label="Main">
      <button class="header__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
        <span class="sr-only">Menu</span>
        <span class="header__bars" aria-hidden="true"></span>
      </button>
      <ul id="nav-menu" class="header__menu">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="#enquire" class="btn btn--primary header__cta">{cta.primary}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 243 238 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
  }
  .header__brand {
    text-decoration: none;
  }
  .header__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 0;
    color: var(--plum);
    cursor: pointer;
  }
  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 1.4rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s;
  }
  .header__bars {
    position: relative;
  }
  .header__bars::before,
  .header__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .header__bars::before {
    top: -0.45rem;
  }
  .header__bars::after {
    top: 0.45rem;
  }
  [aria-expanded='true'] .header__bars {
    background: transparent;
  }
  [aria-expanded='true'] .header__bars::before {
    transform: translateY(0.45rem) rotate(45deg);
  }
  [aria-expanded='true'] .header__bars::after {
    transform: translateY(-0.45rem) rotate(-45deg);
  }

  .header__menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 1rem var(--gutter) 1.5rem;
    position: absolute;
    inset: 100% 0 auto;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    gap: 0.25rem;
  }
  .header__menu.is-open {
    display: flex;
  }
  .header__menu a:not(.btn) {
    display: block;
    padding: 0.7rem 0;
    font-weight: 500;
    color: var(--brown);
    text-decoration: none;
  }
  .header__menu a:not(.btn):hover {
    color: var(--plum);
  }
  .header__cta {
    margin-top: 0.75rem;
    width: 100%;
  }

  @media (min-width: 56rem) {
    .header__toggle {
      display: none;
    }
    .header__menu {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
      padding: 0;
      background: none;
      border: 0;
    }
    .header__menu a:not(.btn) {
      font-size: 0.9rem;
      padding: 0.25rem 0;
    }
    .header__cta {
      margin: 0;
      width: auto;
      min-height: 2.6rem;
      padding: 0.6rem 1.2rem;
      font-size: 0.82rem;
    }
  }
</style>
