---
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { hero } from '../content/site';
import photo from '../assets/mila-water-bottle.png';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Same photo, blurred and washed with cream behind the text (desktop) -->
  <div class="hero__backdrop" aria-hidden="true">
    <Image src={photo} alt="" width={480} format="webp" loading="eager" />
  </div>

  <div class="container container--wide hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        {hero.headline}<br />
        <em>{hero.headlineAccent}</em> {hero.headlineEnd}
      </h1>
      <p class="hero__sub">{hero.subheadline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary hero__cta" href={hero.ctaHref}>
          {hero.ctaLabel} <Icon name="arrow" size={18} />
        </a>
        <a class="hero__link" href={hero.secondaryHref}>
          {hero.secondaryLabel} <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </div>

  <div class="hero__media">
    <div class="hero__photo">
      <Picture
        src={photo}
        alt={hero.photoAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 1086]}
        sizes="(min-width: 60rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <!-- Curved divider between photo and text (phones and tablets) -->
    <svg class="hero__lines hero__lines--stacked" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-2 1C30 14 70 14 102 1" />
    </svg>
  </div>

  <!-- Fine curved lines, drawn over the whole hero (desktop) -->
  <svg class="hero__lines hero__lines--wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <ellipse cx="100" cy="50" rx="50.6" ry="78.6" />
    <path d="M0 64C13 72 25 82 31 100" />
  </svg>
</section>

<style>
  /* Phones and tablets: photo on top, text below on cream */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(ellipse 60% 70% at 18% 35%, rgb(255 253 250 / 0.9), transparent 70%),
      var(--cream);
  }
  .hero__backdrop {
    display: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 0.5rem 3rem;
  }
  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(58 42 36 / 0.78);
  }
  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.6rem, 1rem + 3.2vw, 4.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  h1 em {
    font-style: italic;
  }
  .hero__sub {
    max-width: 30rem;
    margin: 0 0 2rem;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .hero__cta,
  .hero__link {
    gap: 0.75rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero__cta {
    padding: 0.95rem 1.75rem;
  }
  .hero__link {
    display: inline-flex;
    align-items: center;
    padding-block: 0.5rem;
    color: var(--plum);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition: text-decoration-color 0.2s;
  }
  .hero__link:hover {
    text-decoration-color: currentColor;
  }

  .hero__media {
    position: relative;
    order: -1;
  }
  .hero__photo {
    aspect-ratio: 5 / 6;
    max-height: 36rem;
    width: 100%;
    /* Curved, softly blurred bottom edge where the photo meets the cream */
    -webkit-mask-image: radial-gradient(ellipse 150% 100% at 50% 0%, #000 90%, transparent 97%);
    mask-image: radial-gradient(ellipse 150% 100% at 50% 0%, #000 90%, transparent 97%);
  }
  .hero__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    /* Zoom in a little so Mila stays the focus on small screens */
    transform: scale(1.3);
    transform-origin: 38% 40%;
  }

  .hero__lines {
    position: absolute;
    pointer-events: none;
    fill: none;
    stroke: var(--clay);
    stroke-width: 1;
    opacity: 0.7;
  }
  .hero__lines * {
    vector-effect: non-scaling-stroke;
  }
  .hero__lines--wide {
    display: none;
  }
  .hero__lines--stacked {
    left: 0;
    bottom: -0.5rem;
    width: 100%;
    height: 3rem;
  }

  @media (max-width: 30rem) {
    .hero__cta {
      width: 100%;
    }
  }

  /* Desktop: text on the left, photo on the right inside a large curve */
  @media (min-width: 60rem) {
    .hero {
      /* Slide under the transparent header so the photo reaches the top */
      margin-top: calc(-1 * var(--header-h));
      min-height: clamp(40rem, 100svh, 58rem);
      flex-direction: row;
      align-items: center;
      background: var(--cream);
    }
    .hero__backdrop {
      display: block;
      position: absolute;
      inset: 0;
    }
    .hero__backdrop :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 30% 40%;
      filter: blur(28px) saturate(0.9);
      transform: scale(1.15);
    }
    /* Cream wash so the text stays easy to read */
    .hero__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 65% at 22% 40%, rgb(255 253 250 / 0.75), transparent 75%),
        linear-gradient(90deg, rgb(247 243 238 / 0.9) 0%, rgb(247 243 238 / 0.78) 40%, rgb(247 243 238 / 0.55) 60%);
    }
    .hero__inner {
      padding-block: calc(var(--header-h) + 3rem) 4rem;
    }
    .hero__copy {
      max-width: 40vw;
    }
    .hero__actions {
      flex-wrap: nowrap;
      width: max-content;
    }
    /* Scales with the screen so the headline always stays clear of the photo */
    h1 {
      font-size: 3.9vw;
    }
    /* Smaller text and buttons grow a little on large monitors to stay in proportion */
    .hero__eyebrow {
      font-size: max(0.75rem, 0.55vw);
    }
    .hero__sub {
      max-width: max(30rem, 26vw);
      font-size: max(1.05rem, 0.85vw);
    }
    .hero__cta,
    .hero__link {
      font-size: max(0.82rem, 0.6vw);
    }
    .hero__media {
      position: static;
      order: 0;
    }
    .hero__photo {
      position: absolute;
      inset: 0 0 0 50%;
      width: auto;
      max-height: none;
      aspect-ratio: auto;
      -webkit-mask-image: none;
      mask-image: none;
      clip-path: ellipse(100% 78% at 100% 50%);
      z-index: 1;
    }
    .hero__photo :global(img) {
      object-position: 30% 30%;
      transform: none;
    }
    .hero__lines--wide {
      display: block;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .hero__lines--stacked {
      display: none;
    }
  }
</style>
