---
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { hero } from '../content/site';
import photo from '../assets/mila-water-bottle.png';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Same photo, blurred and washed with cream behind the text (desktop) -->
  <div class="hero__backdrop" aria-hidden="true">
    <Image src={photo} alt="" width={480} format="webp" loading="eager" />
  </div>

  <div class="container container--wide hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        {hero.headline}<br />
        <em>{hero.headlineAccent}</em> {hero.headlineEnd}
      </h1>
      <p class="hero__sub">{hero.subheadline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary hero__cta" href={hero.ctaHref}>
          {hero.ctaLabel} <Icon name="arrow" size={18} />
        </a>
        <a class="hero__link" href={hero.secondaryHref}>{hero.secondaryLabel}</a>
      </div>
    </div>
  </div>

  <div class="hero__media">
    <div class="hero__photo">
      <Picture
        src={photo}
        alt={hero.photoAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 1086]}
        sizes="(min-width: 60rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <!-- Wavy divider between photo and text (phones and tablets); follows the photo's fade -->
    <svg class="hero__lines hero__lines--stacked" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-2 86C15 78 30 78 45 84S75 92 102 80" />
    </svg>
  </div>

  <!-- Fine curved lines, drawn over the whole hero (desktop) -->
  <svg class="hero__lines hero__lines--wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <!-- Follows the wavy edge of the photo (see the mask on .hero__photo) -->
    <path d="M64 0C58 10 50 20 52 34C54 48 60 52 58 64C56 76 51 86 56 100" />
    <path d="M0 64C13 72 25 82 31 100" />
  </svg>
</section>

<style>
  /* Phones and tablets: photo on top, text below on cream */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(ellipse 60% 70% at 18% 35%, rgb(255 253 250 / 0.9), transparent 70%),
      var(--cream);
  }
  .hero__backdrop {
    display: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 2rem 3rem;
  }
  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(58 42 36 / 0.78);
  }
  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.6rem, 1rem + 3.2vw, 4.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  h1 em {
    font-style: italic;
  }
  .hero__sub {
    max-width: 30rem;
    margin: 0 0 2rem;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .hero__cta,
  .hero__link {
    gap: 0.75rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero__cta {
    padding: 0.95rem 1.75rem;
  }
  .hero__link {
    display: inline-flex;
    align-items: center;
    padding-block: 0.5rem;
    color: var(--plum);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
    transition: text-decoration-thickness 0.2s;
  }
  .hero__link:hover {
    text-decoration-thickness: 2px;
  }

  .hero__media {
    position: relative;
    order: -1;
  }
  .hero__photo {
    aspect-ratio: 6 / 5;
    max-height: 32rem;
    width: 100%;
    /* Wavy, soft fade at the bottom where the photo meets the cream */
    -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><filter id='f' x='-5%' y='-20%' width='110%' height='140%'><feGaussianBlur stdDeviation='3.5'/></filter><path filter='url(%23f)' fill='%23000' d='M-10 -10V86L-2 86C15 78 30 78 45 84S75 92 102 80L110 80V-10Z'/></svg>");
    mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><filter id='f' x='-5%' y='-20%' width='110%' height='140%'><feGaussianBlur stdDeviation='3.5'/></filter><path filter='url(%23f)' fill='%23000' d='M-10 -10V86L-2 86C15 78 30 78 45 84S75 92 102 80L110 80V-10Z'/></svg>");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
  .hero__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    /* Zoom in to show Mila from head to waist on small screens */
    transform: scale(1.25);
    transform-origin: 47% 45%;
  }

  .hero__lines {
    position: absolute;
    pointer-events: none;
    fill: none;
    stroke: var(--plum);
    stroke-width: 1;
    shape-rendering: geometricPrecision;
  }
  .hero__lines * {
    vector-effect: non-scaling-stroke;
  }
  .hero__lines--wide {
    display: none;
  }
  .hero__lines--stacked {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 30rem) {
    .hero__cta {
      width: 100%;
    }
  }

  /* Desktop: text on the left, photo on the right inside a large curve */
  @media (min-width: 60rem) {
    .hero {
      /* Slide under the transparent header so the photo reaches the top */
      margin-top: calc(-1 * var(--header-h));
      min-height: clamp(40rem, 100svh, 58rem);
      flex-direction: row;
      align-items: center;
      background: var(--cream);
    }
    .hero__backdrop {
      display: block;
      position: absolute;
      inset: 0;
    }
    .hero__backdrop :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 30% 40%;
      filter: blur(28px) saturate(0.9);
      transform: scale(1.15);
    }
    /* Cream wash so the text stays easy to read */
    .hero__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 65% at 22% 40%, rgb(255 253 250 / 0.75), transparent 75%),
        linear-gradient(90deg, rgb(247 243 238 / 0.9) 0%, rgb(247 243 238 / 0.72) 38%, rgb(247 243 238 / 0.35) 56%, rgb(247 243 238 / 0.2) 70%);
    }
    .hero__inner {
      padding-block: calc(var(--header-h) + 3rem) 4rem;
    }
    .hero__copy {
      max-width: 40vw;
    }
    .hero__actions {
      flex-wrap: nowrap;
      width: max-content;
    }
    /* Scales with the screen so the headline always stays clear of the photo */
    h1 {
      font-size: 3.9vw;
    }
    /* Smaller text and buttons grow a little on large monitors to stay in proportion */
    .hero__eyebrow {
      font-size: max(0.75rem, 0.55vw);
    }
    .hero__sub {
      max-width: max(30rem, 26vw);
      font-size: max(1.05rem, 0.85vw);
    }
    .hero__cta,
    .hero__link {
      font-size: max(0.82rem, 0.6vw);
    }
    .hero__media {
      position: static;
      order: 0;
    }
    .hero__photo {
      position: absolute;
      inset: 0 0 0 50%;
      width: auto;
      max-height: none;
      aspect-ratio: auto;
      /* Wavy left edge that fades softly into the blurred background */
      -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><filter id='f' x='-20%' y='-5%' width='140%' height='110%'><feGaussianBlur stdDeviation='2.6'/></filter><path filter='url(%23f)' fill='%23000' d='M110 -10H30C18 10 2 20 6 34C10 48 22 52 18 64C14 76 4 86 14 110H110Z'/></svg>");
      mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><filter id='f' x='-20%' y='-5%' width='140%' height='110%'><feGaussianBlur stdDeviation='2.6'/></filter><path filter='url(%23f)' fill='%23000' d='M110 -10H30C18 10 2 20 6 34C10 48 22 52 18 64C14 76 4 86 14 110H110Z'/></svg>");
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      z-index: 1;
    }
    .hero__photo :global(img) {
      object-position: 30% 30%;
      transform: none;
    }
    .hero__lines--wide {
      display: block;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
    }
    .hero__lines--stacked {
      display: none;
    }
  }
</style>
