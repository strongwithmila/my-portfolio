---
import Icon from './Icon.astro';
import { offer, cta, founding } from '../content/site';
---

<section class="section" id="package" aria-labelledby="package-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">The coaching package</p>
      <h2 id="package-title">{offer.name || offer.title}</h2>
      {offer.name && <p class="subtitle">{offer.title}</p>}
      <p class="lead">{offer.summary}</p>
    </div>

    <div class="package">
      <!-- First in the markup so phones show it straight after the intro; placed in the right column on desktop -->
      <aside class="includes" aria-labelledby="includes-title">
        <h3 id="includes-title">What’s included</h3>
        <ul>
          {offer.includes.map((item) => (
            <li><Icon name="check" size={20} class="includes__check" />{item}</li>
          ))}
        </ul>
        <dl class="includes__facts">
          <div>
            <dt>Where</dt>
            <dd>{offer.location}</dd>
          </div>
          <div>
            <dt>Investment</dt>
            <dd>{offer.price || offer.priceNote}</dd>
          </div>
        </dl>
        <a class="btn btn--primary includes__cta" href="#enquire">{cta.primary}</a>
        {founding.enabled && <p class="includes__hint">{founding.heading} are available now.</p>}
      </aside>

      <div class="journey">
        <h3 class="journey__title" id="journey-title">{offer.journeyHeading}</h3>
        <ol class="timeline" aria-labelledby="journey-title">
          {offer.steps.map((s, i) => (
            <li class="step">
              <span class="step__dot" aria-hidden="true">{i + 1}</span>
              <h4 class="step__title">{s.title}</h4>
              <p class="step__detail">{s.detail}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .subtitle {
    font-weight: 600;
    color: var(--plum);
  }
  .package {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .journey__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--plum);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 1.05rem;
    top: 0.5rem;
    bottom: 0.5rem;
    border-left: 1.5px dashed var(--line);
  }
  .step {
    position: relative;
    padding: 0 0 1.6rem 3.5rem;
  }
  .step:last-child {
    padding-bottom: 0;
  }
  .step__dot {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 50%;
    background: var(--cream);
    border: 1.5px solid var(--plum);
    color: var(--plum);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .step__title {
    margin: 0.3rem 0 0.3rem;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--brown);
  }
  .step__detail {
    margin: 0;
    font-size: 0.95rem;
  }
  .includes {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 2.5rem);
  }
  .includes ul {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  .includes li {
    display: flex;
    gap: 0.6rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  :global(.includes__check) {
    flex: none;
    color: var(--forest);
    margin-top: 0.15rem;
  }
  .includes__facts {
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.9rem;
  }
  .includes__facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--plum);
  }
  .includes__facts dd {
    margin: 0;
    font-size: 0.95rem;
  }
  .includes__cta {
    width: 100%;
  }
  .includes__hint {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: 0.85rem;
  }
  /* Desktop: journey on the left, package summary on the right */
  @media (min-width: 60rem) {
    /* Wider panel stretched to the journey's height; facts side by side to keep it compact */
    .package {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: stretch;
    }
    .includes {
      display: flex;
      flex-direction: column;
    }
    .includes li {
      padding-block: 0.35rem;
    }
    .includes__facts {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.75rem;
    }
    .includes__cta {
      margin-top: auto;
    }
    /* Spread the journey steps so the timeline ends level with the panel */
    .journey {
      display: flex;
      flex-direction: column;
    }
    .timeline {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.6rem;
    }
    .step {
      padding-bottom: 0;
    }
    .journey {
      grid-column: 1;
      grid-row: 1;
    }
    .includes {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
