# Copy to `.env` and fill in. Never commit real values.

# Public domain once chosen, e.g. https://strongwithmila.de — enables canonical URL and og:url.
SITE_URL=

# Optional: endpoint of a form service (e.g. Formspree, Tally, Web3Forms) that accepts a
# JSON POST. Leave empty to use the built-in fallback, which opens a pre-filled email to
# the contact address instead. Choosing a service needs Mila's approval and a data-processing
# agreement (GDPR Art. 28) before launch.
PUBLIC_FORM_ENDPOINT=
